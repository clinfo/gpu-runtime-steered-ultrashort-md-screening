; Public example MDP. Obsolete metadata keys and private comments removed.
define = -DPOSRES
integrator = md
nsteps = 50000
dt = 0.002
nstxout = 0
nstvout = 0
nstxout-compressed = 5000
nstenergy = 5000
nstlog = 5000
continuation = no
constraint-algorithm = lincs
constraints = all-bonds
lincs-iter = 1
lincs-order = 6
cutoff-scheme = Verlet
nstlist = 20
vdwtype = Cut-off
rvdw = 1.0
dispcorr = EnerPres
coulombtype = PME
pme-order = 4
fourierspacing = 0.12
rcoulomb = 1.0
ewald-rtol = 1e-8
tcoupl = V-rescale
tc-grps = Protein_LIG Water_and_ions
tau-t = 0.1 0.1
ref-t = 298 298
pcoupl = no
pbc = xyz
gen-vel = yes
gen-temp = 298
gen-seed = -1
